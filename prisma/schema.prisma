// Esquema de datos — SoftHard A&L, Fase 1
// Estados y valores de dominio en español (coinciden con docs/specs/fase-1.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles de la aplicación. En Fase 1 `admin` equivale a `encargado`.
enum Role {
  cliente
  trabajador
  encargado
  admin
}

/// Estados de una solicitud. Fase 1 usa hasta `aceptada`/`rechazada`/`expirada`;
/// el resto se implementa en Fase 3, pero se declara ya para no migrar el enum.
enum ServiceStatus {
  pendiente
  diagnosticada
  aceptada
  rechazada
  expirada
  en_reparacion
  lista
  entregada
}

enum EquipmentType {
  ordenador
  portatil
  impresora
  otro
}

enum Modality {
  domicilio
  taller
}

enum TimeSlot {
  manana
  tarde
  indiferente
}

/// Categorías del catálogo. Lista cerrada para la Fase 2.
enum ProductCategory {
  ordenadores
  portatiles
  impresoras
  accesorios
  consumibles
}

/// Estado de la decisión del cliente sobre el presupuesto.
enum QuoteStatus {
  pendiente
  aceptado
  rechazado
  expirado
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(cliente)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests ServiceRequest[] @relation("ClientRequests")
  assigned ServiceRequest[] @relation("AssignedRequests")

  @@index([role])
  @@map("users")
}

model ServiceRequest {
  id String @id @default(cuid())

  clientId String
  client   User   @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("AssignedRequests", fields: [assigneeId], references: [id], onDelete: SetNull)

  equipmentType EquipmentType
  brand         String
  model         String
  issue         String        @db.Text
  modality      Modality
  preferredDate DateTime?
  timeSlot      TimeSlot      @default(indiferente)

  status ServiceStatus @default(pendiente)

  /// Calculado al crear el presupuesto. Se evalúa de forma perezosa al leer:
  /// no hay cron en Fase 1.
  expiresAt DateTime?

  quote Quote?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([status])
  @@index([assigneeId])
  @@map("service_requests")
}

model Quote {
  id String @id @default(cuid())

  requestId String         @unique
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Importe propuesto por el taller antes de aplicar la regla del descuento.
  budgetAmount Decimal @db.Decimal(10, 2)

  /// Copia de la tarifa de diagnóstico (X) en el momento del presupuesto:
  /// si X cambia después, los presupuestos históricos no se alteran.
  diagnosticFee Decimal @db.Decimal(10, 2)

  /// Se rellena al aceptar (presupuesto - X) o al rechazar (X).
  finalAmount Decimal? @db.Decimal(10, 2)

  status    QuoteStatus @default(pendiente)
  expiresAt DateTime
  decidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@map("quotes")
}

/// Producto del catálogo. `active` implementa borrado lógico: los productos
/// archivados desaparecen de la tienda y del panel, pero conservan su historial.
model Product {
  id          String          @id @default(cuid())
  name        String
  description String          @db.Text
  price       Decimal         @db.Decimal(10, 2)
  stock       Int             @default(0)
  imageUrl    String?
  category    ProductCategory
  active      Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@map("products")
}

/// Configuración de negocio. Fila única: id fijo = 1.
model Config {
  id             Int      @id @default(1)
  diagnosticFee  Decimal  @default(30) @db.Decimal(10, 2)
  expirationDays Int      @default(7)
  updatedAt      DateTime @updatedAt

  @@map("config")
}
