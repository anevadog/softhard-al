// Esquema de datos — SoftHard A&L, Fase 1
// Estados y valores de dominio en español (coinciden con docs/specs/fase-1.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Roles de la aplicación. En Fase 1 `admin` equivale a `encargado`.
enum Role {
  cliente
  trabajador
  encargado
  admin
}

/// Estados de una solicitud. Fase 1 usa hasta `aceptada`/`rechazada`/`expirada`;
/// el resto se implementa en Fase 3, pero se declara ya para no migrar el enum.
enum ServiceStatus {
  pendiente
  diagnosticada
  aceptada
  rechazada
  expirada
  en_reparacion
  esperando_repuesto
  lista
  entregada
}

/// Tipo de nota interna de una reparación.
enum RequestNoteType {
  normal
  falta_repuesto
}

enum EquipmentType {
  ordenador
  portatil
  impresora
  otro
}

enum Modality {
  domicilio
  taller
}

enum TimeSlot {
  manana
  tarde
  indiferente
}

/// Categorías del catálogo. Lista cerrada para la Fase 2.
enum ProductCategory {
  ordenadores
  portatiles
  impresoras
  accesorios
  consumibles
}

/// Estado de la decisión del cliente sobre el presupuesto.
enum QuoteStatus {
  pendiente
  aceptado
  rechazado
  expirado
}

/// Estado de un pedido de la tienda. En Fase 2 solo se crea `pendiente`;
/// el resto queda preparado para la gestion administrativa posterior.
enum OrderStatus {
  pendiente
  pagado
  entregado
  cancelado
}

/// Motivo de un movimiento del libro de stock.
enum StockMovementReason {
  stock_inicial
  venta
  cancelacion_pedido
  reposicion
  ajuste
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(cliente)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests             ServiceRequest[]           @relation("ClientRequests")
  assigned             ServiceRequest[]           @relation("AssignedRequests")
  orders               Order[]
  stockMovements       StockMovement[]
  statusChanges        ServiceStatusHistory[]     @relation("StatusChangedBy")
  assignmentChanges    ServiceAssignmentHistory[] @relation("AssignmentChangedBy")
  assignmentsFrom      ServiceAssignmentHistory[] @relation("AssignmentFrom")
  assignmentsTo        ServiceAssignmentHistory[] @relation("AssignmentTo")
  workLogs             WorkLog[]                  @relation("WorkerWorkLogs")
  editedWorkLogs       WorkLog[]                  @relation("WorkLogEditor")
  requestNotes         RequestNote[]              @relation("RequestNoteAuthor")
  resolvedRequestNotes RequestNote[]              @relation("RequestNoteResolver")

  @@index([role])
  @@map("users")
}

model ServiceRequest {
  id String @id @default(cuid())

  clientId String
  client   User   @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("AssignedRequests", fields: [assigneeId], references: [id], onDelete: SetNull)

  equipmentType EquipmentType
  brand         String
  model         String
  issue         String        @db.Text
  modality      Modality
  preferredDate DateTime?
  timeSlot      TimeSlot      @default(indiferente)

  status ServiceStatus @default(pendiente)

  /// Calculado al crear el presupuesto. Se evalúa de forma perezosa al leer:
  /// no hay cron en Fase 1.
  expiresAt DateTime?

  quote Quote?

  /// Se actualiza en la misma transacción de cualquier acción relevante:
  /// cambio de estado, asignación, nota o fichaje.
  lastActivityAt DateTime @default(now())

  statusHistory     ServiceStatusHistory[]
  assignmentHistory ServiceAssignmentHistory[]
  workLogs          WorkLog[]
  notes             RequestNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([status])
  @@index([assigneeId])
  @@index([lastActivityAt])
  @@map("service_requests")
}

model Quote {
  id String @id @default(cuid())

  requestId String         @unique
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// Importe propuesto por el taller antes de aplicar la regla del descuento.
  budgetAmount Decimal @db.Decimal(10, 2)

  /// Copia de la tarifa de diagnóstico (X) en el momento del presupuesto:
  /// si X cambia después, los presupuestos históricos no se alteran.
  diagnosticFee Decimal @db.Decimal(10, 2)

  /// Se rellena al aceptar (presupuesto - X) o al rechazar (X).
  finalAmount Decimal? @db.Decimal(10, 2)

  status    QuoteStatus @default(pendiente)
  expiresAt DateTime
  decidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@map("quotes")
}

/// Historial de cambios de estado de una solicitud.
model ServiceStatusHistory {
  id String @id @default(cuid())

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  fromStatus ServiceStatus
  toStatus   ServiceStatus

  changedById String?
  changedBy   User?   @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  reason    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([toStatus])
  @@map("service_status_history")
}

/// Historial de asignaciones y devoluciones de una solicitud.
model ServiceAssignmentHistory {
  id String @id @default(cuid())

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  fromAssigneeId String?
  fromAssignee   User?   @relation("AssignmentFrom", fields: [fromAssigneeId], references: [id], onDelete: SetNull)

  toAssigneeId String?
  toAssignee   User?   @relation("AssignmentTo", fields: [toAssigneeId], references: [id], onDelete: SetNull)

  changedById String?
  changedBy   User?   @relation("AssignmentChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  reason    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([toAssigneeId, createdAt])
  @@map("service_assignment_history")
}

/// Fichaje de un trabajador. `requestId` nulo representa horas generales;
/// en ese caso la nota es obligatoria (regla de aplicación).
model WorkLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation("WorkerWorkLogs", fields: [userId], references: [id], onDelete: Restrict)

  requestId String?
  request   ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  note String? @db.Text

  editedById String?
  editedBy   User?   @relation("WorkLogEditor", fields: [editedById], references: [id], onDelete: SetNull)

  editedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, startedAt])
  @@index([requestId, startedAt])
  @@map("work_logs")
}

/// Nota interna de una reparación. Las de tipo `falta_repuesto` se destacan
/// hasta que alguien las marca como atendidas.
model RequestNote {
  id String @id @default(cuid())

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("RequestNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  type RequestNoteType @default(normal)
  body String          @db.Text

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("RequestNoteResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([type, resolvedAt])
  @@map("request_notes")
}

/// Producto del catálogo. `active` implementa borrado lógico: los productos
/// archivados desaparecen de la tienda y del panel, pero conservan su historial.
model Product {
  id          String          @id @default(cuid())
  name        String
  description String          @db.Text
  price       Decimal         @db.Decimal(10, 2)
  stock       Int             @default(0)
  imageUrl    String?
  category    ProductCategory
  active      Boolean         @default(true)

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@map("products")
}

/// Pedido de la tienda. El total y el precio de cada linea son copias del
/// momento de la compra: un cambio posterior de precio no altera el historico.
model Order {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  total  Decimal     @db.Decimal(10, 2)
  status OrderStatus @default(pendiente)

  /// Evita duplicados por doble clic o reintentos de red. Puede ser nulo en
  /// pedidos creados fuera del checkout (por ejemplo, una importacion futura).
  idempotencyKey String?

  items          OrderItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int
  /// Precio unitario congelado en el momento de crear el pedido.
  price    Decimal @db.Decimal(10, 2)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

/// Libro de movimientos de stock. Invariante: `Product.stock` es la suma de
/// `variation` de todos sus movimientos. `userId` nulo representa sistema,
/// migración o seed; `orderId` nulo indica un movimiento sin pedido asociado.
model StockMovement {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variation Int
  reason    StockMovementReason

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  note      String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

/// Configuración de negocio. Fila única: id fijo = 1.
model Config {
  id                   Int      @id @default(1)
  diagnosticFee        Decimal  @default(30) @db.Decimal(10, 2)
  expirationDays       Int      @default(7)
  inactiveRequestHours Int      @default(48)
  openWorkLogHours     Int      @default(8)
  updatedAt            DateTime @updatedAt

  @@map("config")
}
