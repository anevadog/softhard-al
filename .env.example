DATABASE_URL="postgresql://postgres:postgres@localhost:5432/softhard?schema=public"

# El seed solo se ejecuta sin confirmación contra hosts locales. Para cargar los
# datos demo en una base remota, descomenta esta variable de forma consciente.
# SEED_ALLOW_PRODUCTION="true"

AUTH_SECRET="genera-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Emails transaccionales (Fase 5.2). Sin EMAIL_PROVIDER se usa "console": no se
# envía nada. En desarrollo, "mailpit" (http://localhost:8025, ver README).
# "resend" está preparado pero no se usa en esta fase.
# EMAIL_PROVIDER="mailpit"
# MAILPIT_URL="http://localhost:8025"
# EMAIL_FROM="SoftHard A&L (demo) <no-reply@softhard-al.demo>"
# APP_URL="http://localhost:3000"
# RESEND_API_KEY=""

# Pasarela de pago (Fase 5.3). "mock" (por defecto): página simulada en
# /pago/mock/<sesión>, no se cobra nada. "stripe" está reservado, no activo.
# PAYMENT_PROVIDER="mock"
